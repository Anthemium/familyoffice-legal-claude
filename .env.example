# Сборка: static (GitHub Pages) по умолчанию; server — для Timeweb (Node, auth, S3, Postgres)
FOL_TARGET=static
NEXT_PUBLIC_BASE_PATH=

# Timeweb Managed PostgreSQL
DATABASE_URL=postgresql://fol_app:CHANGE_ME@HOST:5432/fol?sslmode=require

# Timeweb S3 (S3-совместимый API)
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=fol-vault
S3_ACCESS_KEY=
S3_SECRET_KEY=

# WebAuthn (passkey + аппаратный ключ для Студиоло)
WEBAUTHN_RP_ID=familyoffice.legal
WEBAUTHN_ORIGIN=https://familyoffice.legal
